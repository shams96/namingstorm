# Copy this to .env.local and fill in real values. Never commit .env.local.

# Google Gemini API (required — name generation, evolve, brand story)
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Postgres connection (required in production; falls back to local SQLite if omitted)
DATABASE_URL=

# Stripe (required for payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin (required for verifying signed-in users server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MarkerAPI — preliminary USPTO trademark screening (optional; feature is
# disabled gracefully if unset)
MARKERAPI_USERNAME=
MARKERAPI_PASSWORD=

# Runtime
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
